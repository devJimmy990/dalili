# Neon connection string — copy it from the Neon dashboard
# (Project → Connection Details → the pooled connection, host contains "-pooler").
# Keep ?sslmode=require; Neon refuses plaintext connections.
# Never commit the real value — put it in .env, which is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

NODE_ENV=development
PORT=3000

# Allowed browser origins: "*" for any, or a comma-separated list.
# The Flutter app is not a browser, so this only matters for a web build.
CORS_ORIGIN=*

# Default page size for paginated endpoints.
PAGE_SIZE=20

# Shared book links (https://<this host>/dalili/<name>-<bibid>).
# Where people WITHOUT the app are sent: the React page, once it is deployed.
LANDING_URL=
# The SHA-256 fingerprint(s) of the key the Android app is signed with,
# comma-separated. Without it a tapped link opens the browser, not the app.
# Debug key (from `keytool -list -v -keystore ~/.android/debug.keystore`):
ANDROID_SHA256=67:04:4E:BB:F1:A6:69:99:2A:A9:04:90:D9:D0:14:81:9F:84:76:C8:D1:84:15:28:95:CC:8A:F1:27:FC:9E:E7
ANDROID_PACKAGE=com.example.dalili
