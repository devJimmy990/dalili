# Neon connection string — copy it from the Neon dashboard
# (Project → Connection Details → the pooled connection, host contains "-pooler").
# Keep ?sslmode=require; Neon refuses plaintext connections.
# Never commit the real value — put it in .env, which is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

NODE_ENV=development
PORT=3000

# Allowed browser origins: "*" for any, or a comma-separated list.
# The Flutter app is not a browser, so this only matters for a web build.
CORS_ORIGIN=*

# Default page size for paginated endpoints.
PAGE_SIZE=20
