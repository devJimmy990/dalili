// Dalili — Smart Library Assistant
// Database schema (PostgreSQL / Neon)
//
// Design notes
// ─────────────────────────────────────────────────────────────
// * Anything a reader sees in two languages is a lookup table with
//   `nameAr` / `nameEn` and a stable string id (Department, Place,
//   Language, EditionType, ArticleType, SourceType). Rows reference the
//   id, never a translated string, so a new locale or a renamed label is
//   one UPDATE instead of a data migration. The API picks the column from
//   `?lang=`.
// * Free text stays on the row it describes (title, author, publisher,
//   subjects): the catalogue holds one spelling of those, not a pair.
// * Nullability is deliberate: a column is NOT NULL only when the record
//   cannot exist without it (identity, title, call number, the department
//   it belongs to). Every other field is optional and stored as NULL when
//   the sheet leaves it blank — never as an empty string, so "unknown"
//   and "empty" stay distinguishable and the app can hide the row.
// * A book's physical location is its department (which carries the map
//   node used by in-app navigation) plus `shelf`, the shelf number as the
//   librarians print it on the stack — a library-wide number, not an index
//   inside the department.
// * Language is many-to-many with a role: a book can be written in two
//   languages (Korean + English) or be a translation (Arabic, translated
//   from English).
// * Edition is split in three: the number (2 → "2nd"), the kind
//   (standard / international / teacher / not stated) and whether the
//   cataloguer inferred it (`[1st. ed]` in brackets = not printed on the
//   book itself).
// * Book ⇄ Article is many-to-many: one article may be recommended for
//   several books.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A library section (كهرباء, عمارة, ...). `id` doubles as the
/// node id inside library_map.json, so navigation can target it.
model Department {
  id        String  @id
  nameAr    String
  nameEn    String
  /// Node id in library_map.json. Null when the section is not on the map yet.
  mapNodeId String?
  sortOrder Int     @default(0)

  books Book[]

  @@map("departments")
}

/// Publication city (New Delhi, القاهرة, ...).
model Place {
  id     String @id
  nameAr String
  nameEn String

  books Book[]

  @@map("places")
}

/// A language a book's text is written in (ar, en, ko).
model Language {
  id     String @id
  nameAr String
  nameEn String

  books BookLanguage[]

  @@map("languages")
}

/// The kind of edition: "standard" (numbered), "international", "teacher",
/// or "unspecified" when the record states none ([د.ط]).
model EditionType {
  id        String @id
  nameAr    String
  nameEn    String
  sortOrder Int    @default(0)

  books Book[]

  @@map("edition_types")
}

/// Normalized kind of a related document: مقال, بحث, مقال مراجعة, بحث مؤتمر...
model ArticleType {
  id        String @id
  nameAr    String
  nameEn    String
  sortOrder Int    @default(0)

  articles Article[]

  @@map("article_types")
}

/// Where a document was published: journal or conference proceedings.
model SourceType {
  id     String @id
  nameAr String
  nameEn String

  articles Article[]

  @@map("source_types")
}

model Book {
  id         String  @id
  /// Dewey-style code that locates the book on its shelf. Required: it is
  /// how a visitor actually finds the book.
  callNumber String
  title      String
  /// Null for the few records catalogued with no author.
  author     String?

  /// Edition number (1, 2, 3...); null when the record gives none.
  editionNumber   Int?
  editionTypeId   String?
  /// True when the sheet printed the edition in brackets — the cataloguer
  /// supplied it, the book does not state it.
  editionInferred Boolean @default(false)

  publisher String?
  /// Publication year; null when the sheet had no usable value.
  year      Int?
  subjects  String?
  /// Library-wide shelf number as printed in the sheet (13..68).
  shelf     Int?
  cover     String?
  isbn      String?

  placeId      String?
  departmentId String

  place       Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  department  Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  editionType EditionType?  @relation(fields: [editionTypeId], references: [id], onDelete: SetNull)
  languages   BookLanguage[]
  articles    BookArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([author])
  @@index([title])
  @@map("books")
}

enum LanguageRole {
  /// The language the book's text is in.
  TEXT
  /// The language a translated book was translated *from*.
  TRANSLATED_FROM
}

model BookLanguage {
  bookId     String
  languageId String
  role       LanguageRole @default(TEXT)
  /// Keeps the sheet's order ("Korean and English", not the reverse).
  position   Int          @default(0)

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([bookId, languageId, role])
  @@index([languageId])
  @@map("book_languages")
}

model Article {
  id          String  @id
  title       String
  authors     String?
  /// Journal or conference proceedings the article appeared in.
  sourceTitle String?
  keywords    String?
  doi         String?
  year        Int?
  issn        String?
  volume      String?
  issue       String?
  pages       String?
  /// Relevance score from the dataset (0..1).
  score       Float?
  url         String?

  typeId       String?
  sourceTypeId String?

  type       ArticleType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  sourceType SourceType?  @relation(fields: [sourceTypeId], references: [id], onDelete: SetNull)
  books      BookArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@map("articles")
}

/// Explicit join table so the pairing can carry data later
/// (ordering, curator notes) without a migration.
model BookArticle {
  bookId    String
  articleId String

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([bookId, articleId])
  @@index([articleId])
  @@map("book_articles")
}
