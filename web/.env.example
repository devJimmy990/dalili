# Base URL of the Dalili API, including /api. The page reads the book from here.
VITE_API_BASE_URL=https://dalili-e0qh.onrender.com/api

# Where people without the app can get it (Play Store page, a direct APK link...).
# Leave empty to hide the "Get the app" button.
VITE_APP_DOWNLOAD_URL=

# Android package, used by the "Open in app" button.
VITE_ANDROID_PACKAGE=com.example.dalili
