# Base URL of the Dalili API, including the /api prefix.
API_BASE_URL=https://<your-service>.onrender.com/api

# Local development alternatives — swap the line above when running the
# backend yourself with `cd backend && npm run dev`:
#   Android emulator → your machine:   http://10.0.2.2:3000/api
#   iOS simulator / desktop:           http://localhost:3000/api
#   Physical device on the same Wi-Fi: http://<your-machine-ip>:3000/api
